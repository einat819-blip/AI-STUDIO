 "segments": [
  {
   "start": 0.0,
   "end": 1.96,
   "text": "משלוחים לכל חלקי הארץ,"
  },
  {
   "start": 2.2,
   "end": 4.44,
   "text": "מהירים, נוחים ועד פתח הבית."
  },
  {
   "start": 4.48,
   "end": 6.1,
   "text": "רגע, איפה אתם גרים?"
  },
  {
   "start": 6.28,
   "end": 6.92,
   "text": "אשכול?"
  },
  {
   "start": 7.26,
   "end": 7.78,
   "text": "אה."
  },
  {
   "start": 8.12,
   "end": 10.18,
   "text": "אז אתם במסלול המיוחד שלנו."
  },
  {
   "start": 10.3,
   "end": 12.88,
   "text": "מסלול פרימיום לתושבי הפריפריה."
  },
  {
   "start": 13.06,
   "end": 14.4,
   "text": "משלוח פעם בשבוע."
  },
  {
   "start": 14.58,
   "end": 15.26,
   "text": "באיזה יום?"
  },
  {
   "start": 15.42,
   "end": 17.08,
   "text": "אנחנו לא אוהבים להתחייב."
  },
  {
   "start": 17.34,
   "end": 18.58,
   "text": "משלוח עד הבית,"
  },
  {
   "start": 18.82,
   "end": 20.88,
   "text": "בתוספת תשלום על האומץ של הנהג."
  },
  {
   "start": 21.04,
   "end": 22.08,
   "text": "או נקודת איסוף."
  },
  {
   "start": 22.4,
   "end": 23.52,
   "text": "אתם עושים את המשלוח,"
  },
  {
   "start": 23.52,
   "end": 24.7,
   "text": "אנחנו גובים עליו."
  },
  {
   "start": 24.9,
   "end": 26.5,
   "text": "ואם כל זה לא מתאים לכם,"
  },
  {
   "start": 26.64,
   "end": 27.88,
   "text": "יש לנו פתרון נוסף."
  },
  {
   "start": 28.64,
   "end": 29.7,
   "text": "אנחנו פשוט לא מגיעים."
  },
  {
   "start": 30.0,
   "end": 31.12,
   "text": "אבל אנחנו בישראל."
  },
  {
   "start": 31.72,
   "end": 33.02,
   "text": "מבחינה גיאוגרפית, כן."
  },
  {
   "start": 33.4,
   "end": 35.86,
   "text": "מבחינתנו, זה קצת יותר מורכב."
  },
  {
   "start": 36.08,
   "end": 37.94,
   "text": "החבילה שלכם יצאה מסין,"
  },
  {
   "start": 38.16,
   "end": 40.52,
   "text": "חצתה אוקיינוסים והגיעה לישראל."
  },
  {
   "start": 40.76,
   "end": 42.26,
   "text": "אבל מכאן לאשכול?"
  },
  {
   "start": 42.48,
   "end": 43.4,
   "text": "בואו לא נגזים."
  },
  {
   "start": 43.6,
   "end": 45.72,
   "text": "משלוחים לכל חלקי הארץ."
  },
  {
   "start": 45.94,
   "end": 47.46,
   "text": "הפריפריה נמכרת בנפרד."
  }
 ],
