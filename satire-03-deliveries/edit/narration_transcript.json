 "duration": 44.356,
 "segments": [
  {
   "start": 0.0,
   "end": 1.74,
   "text": "משלוחים לכל חלקי הארץ,"
  },
  {
   "start": 1.9,
   "end": 4.06,
   "text": "מהירים, נוחים ועד פתח הבית."
  },
  {
   "start": 4.32,
   "end": 5.96,
   "text": "רגע, איפה אתם גרים?"
  },
  {
   "start": 6.32,
   "end": 6.96,
   "text": "אשכול?"
  },
  {
   "start": 7.8,
   "end": 8.44,
   "text": "אה..."
  },
  {
   "start": 9.1,
   "end": 10.26,
   "text": "אז יש לנו כמה אפשרויות."
  },
  {
   "start": 10.48,
   "end": 11.86,
   "text": "משלוח פעם בשבוע."
  },
  {
   "start": 12.0,
   "end": 12.74,
   "text": "באיזה יום?"
  },
  {
   "start": 12.88,
   "end": 13.74,
   "text": "כשיהיה נהג."
  },
  {
   "start": 14.02,
   "end": 15.32,
   "text": "משלוח עד הבית."
  },
  {
   "start": 15.76,
   "end": 17.2,
   "text": "בתוספת תשלום, כמובן."
  },
  {
   "start": 17.48,
   "end": 18.6,
   "text": "או נקודת איסוף."
  },
  {
   "start": 18.82,
   "end": 21.1,
   "text": "כי למה שאנחנו ניסע אם אתם יכולים?"
  },
  {
   "start": 21.3,
   "end": 22.84,
   "text": "ויש גם מסלול מיוחד."
  },
  {
   "start": 23.66,
   "end": 24.58,
   "text": "אנחנו לא מגיעים לשם."
  },
  {
   "start": 24.9,
   "end": 25.46,
   "text": "אבל רגע,"
  },
  {
   "start": 25.7,
   "end": 26.86,
   "text": "אנחנו לא בישראל?"
  },
  {
   "start": 27.0,
   "end": 28.44,
   "text": "בטח שאתם בישראל."
  },
  {
   "start": 28.44,
   "end": 30.12,
   "text": "פשוט לא באזור החלוקה."
  },
  {
   "start": 30.3,
   "end": 34.08,
   "text": "החבילה שלכם חצתה יבשות, ימים ואוקיינוסים."
  },
  {
   "start": 34.3,
   "end": 36.64,
   "text": "הגיעה כל הדרך מסין לישראל."
  },
  {
   "start": 37.46,
   "end": 38.44,
   "text": "אבל להגיע לאשכול?"
  },
  {
   "start": 38.66,
   "end": 39.6,
   "text": "בואו לא נגזים."
  },
  {
   "start": 39.82,
   "end": 43.22,
   "text": "משלוחים לכל חלקי הארץ, חוץ מהחלק שלכם."
  },
  {
   "start": 43.38,
   "end": 44.08,
   "text": "בהצלחה!"
  }
 ],
