  "captions": [
    {
      "start": 0.1,
      "end": 1.84,
      "text": "משלוחים לכל חלקי הארץ!",
      "shown": false
    },
    {
      "start": 2.0,
      "end": 4.26,
      "text": "מהירים, נוחים\\Nועד פתח הבית!",
      "shown": true
    },
    {
      "start": 4.5,
      "end": 5.85,
      "text": "רגע... איפה אתם גרים?",
      "shown": true
    },
    {
      "start": 6.05,
      "end": 6.71,
      "text": "אשכול?!",
      "shown": true
    },
    {
      "start": 7.35,
      "end": 7.62,
      "text": "אה...",
      "shown": true
    },
    {
      "start": 7.95,
      "end": 10.01,
      "text": "אז אתם במסלול\\Nהמיוחד שלנו.",
      "shown": true
    },
    {
      "start": 10.3,
      "end": 12.83,
      "text": "מסלול פרימיום לתושבי הפריפריה.",
      "shown": false
    },
    {
      "start": 14.05,
      "end": 15.32,
      "text": "משלוח פעם בשבוע!",
      "shown": true
    },
    {
      "start": 15.52,
      "end": 16.17,
      "text": "באיזה יום?",
      "shown": true
    },
    {
      "start": 16.42,
      "end": 17.82,
      "text": "אנחנו לא אוהבים\\Nלהתחייב.",
      "shown": true
    },
    {
      "start": 18.3,
      "end": 19.53,
      "text": "משלוח עד הבית,",
      "shown": false
    },
    {
      "start": 19.8,
      "end": 21.68,
      "text": "בתוספת תשלום על האומץ של הנהג.",
      "shown": false
    },
    {
      "start": 22.15,
      "end": 23.11,
      "text": "או נקודת איסוף.",
      "shown": false
    },
    {
      "start": 23.35,
      "end": 25.49,
      "text": "אתם עושים את המשלוח,\\Nאנחנו גובים עליו.",
      "shown": true
    },
    {
      "start": 25.9,
      "end": 28.87,
      "text": "ואם כל זה לא מתאים לכם,\\Nיש לנו פתרון נוסף.",
      "shown": true
    },
    {
      "start": 29.45,
      "end": 30.86,
      "text": "אנחנו פשוט לא מגיעים.",
      "shown": true
    },
    {
      "start": 31.45,
      "end": 32.67,
      "text": "אבל אנחנו בישראל.",
      "shown": true
    },
    {
      "start": 33.05,
      "end": 34.64,
      "text": "מבחינה גיאוגרפית, כן.",
      "shown": true
    },
    {
      "start": 34.9,
      "end": 37.32,
      "text": "מבחינתנו,\\Nזה קצת יותר מורכב.",
      "shown": true
    },
    {
      "start": 37.65,
      "end": 39.49,
      "text": "החבילה שלכם\\Nיצאה מסין,",
      "shown": true
    },
    {
      "start": 39.69,
      "end": 42.03,
      "text": "חצתה אוקיינוסים\\Nוהגיעה לישראל!",
      "shown": true
    },
    {
      "start": 42.4,
      "end": 43.86,
      "text": "אבל מכאן לאשכול?",
      "shown": true
    },
    {
      "start": 44.15,
      "end": 44.95,
      "text": "בואו לא נגזים.",
      "shown": true
    },
    {
      "start": 49.6,
      "end": 51.57,
      "text": "משלוחים לכל חלקי הארץ!",
      "shown": false
    },
    {
      "start": 51.95,
      "end": 53.36,
      "text": "הפריפריה נמכרת בנפרד.",
      "shown": false
    }
  ]
}