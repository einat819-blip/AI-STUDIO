  "captions": [
    {
      "start": 0.1,
      "end": 1.88,
      "text": "משלוחים לכל חלקי הארץ!",
      "shown": false
    },
    {
      "start": 2.04,
      "end": 4.25,
      "text": "מהירים, נוחים\\Nועד פתח הבית!",
      "shown": true
    },
    {
      "start": 4.49,
      "end": 4.9,
      "text": "רגע...",
      "shown": true
    },
    {
      "start": 5.1,
      "end": 5.78,
      "text": "איפה אתם גרים?",
      "shown": true
    },
    {
      "start": 5.96,
      "end": 6.56,
      "text": "אשכול?!",
      "shown": true
    },
    {
      "start": 7.31,
      "end": 7.92,
      "text": "אה...",
      "shown": true
    },
    {
      "start": 8.18,
      "end": 9.75,
      "text": "אז יש לנו כמה אפשרויות!",
      "shown": true
    },
    {
      "start": 9.99,
      "end": 11.24,
      "text": "משלוח פעם בשבוע!",
      "shown": true
    },
    {
      "start": 11.45,
      "end": 12.04,
      "text": "באיזה יום?",
      "shown": true
    },
    {
      "start": 12.32,
      "end": 12.97,
      "text": "כשיהיה נהג.",
      "shown": true
    },
    {
      "start": 13.23,
      "end": 14.6,
      "text": "משלוח עד הבית!",
      "shown": true
    },
    {
      "start": 14.9,
      "end": 15.77,
      "text": "בתוספת תשלום,",
      "shown": true
    },
    {
      "start": 16.17,
      "end": 16.49,
      "text": "כמובן.",
      "shown": true
    },
    {
      "start": 16.87,
      "end": 17.99,
      "text": "או נקודת איסוף!",
      "shown": false
    },
    {
      "start": 18.24,
      "end": 20.25,
      "text": "כי למה שאנחנו ניסע,\\Nאם אתם יכולים?",
      "shown": true
    },
    {
      "start": 21.33,
      "end": 22.8,
      "text": "ויש גם מסלול מיוחד!",
      "shown": true
    },
    {
      "start": 23.53,
      "end": 24.7,
      "text": "אנחנו לא מגיעים לשם.",
      "shown": true
    },
    {
      "start": 26.0,
      "end": 27.9,
      "text": "אבל רגע...\\Nאנחנו לא בישראל?!",
      "shown": true
    },
    {
      "start": 28.28,
      "end": 29.58,
      "text": "בטח שאתם בישראל!",
      "shown": true
    },
    {
      "start": 29.88,
      "end": 31.13,
      "text": "פשוט לא\\Nבאזור החלוקה.",
      "shown": true
    },
    {
      "start": 32.0,
      "end": 35.39,
      "text": "החבילה שלכם חצתה\\Nיבשות, ימים ואוקיינוסים.",
      "shown": true
    },
    {
      "start": 35.68,
      "end": 37.88,
      "text": "הגיעה כל הדרך\\Nמסין לישראל!",
      "shown": true
    },
    {
      "start": 38.3,
      "end": 39.62,
      "text": "אבל להגיע לאשכול?",
      "shown": true
    },
    {
      "start": 40.68,
      "end": 41.44,
      "text": "בואו לא נגזים.",
      "shown": true
    },
    {
      "start": 42.1,
      "end": 43.91,
      "text": "משלוחים לכל חלקי הארץ!",
      "shown": false
    },
    {
      "start": 44.42,
      "end": 45.33,
      "text": "חוץ מהחלק שלכם.",
      "shown": false
    },
    {
      "start": 45.78,
      "end": 46.39,
      "text": "בהצלחה!",
      "shown": false
    }
  ]
