  "captions": [
    {
      "start": 0.15,
      "end": 1.66,
      "text": "משלוחים לכל חלקי הארץ!",
      "shown": false
    },
    {
      "start": 2.0,
      "end": 3.9,
      "text": "מהירים, נוחים\\Nועד פתח הבית!",
      "shown": true
    },
    {
      "start": 7.87,
      "end": 8.48,
      "text": "רגע...",
      "shown": true
    },
    {
      "start": 8.62,
      "end": 9.59,
      "text": "איפה אתם גרים?",
      "shown": true
    },
    {
      "start": 10.12,
      "end": 10.57,
      "text": "אשכול?!",
      "shown": true
    },
    {
      "start": 11.72,
      "end": 12.26,
      "text": "אה...",
      "shown": true
    },
    {
      "start": 12.87,
      "end": 14.44,
      "text": "אז יש לנו כמה אפשרויות!",
      "shown": true
    },
    {
      "start": 14.57,
      "end": 15.68,
      "text": "משלוח פעם בשבוע!",
      "shown": true
    },
    {
      "start": 16.02,
      "end": 16.73,
      "text": "באיזה יום?",
      "shown": true
    },
    {
      "start": 17.22,
      "end": 18.0,
      "text": "כשיהיה נהג.",
      "shown": true
    },
    {
      "start": 21.8,
      "end": 22.78,
      "text": "משלוח עד הבית!",
      "shown": true
    },
    {
      "start": 23.1,
      "end": 24.54,
      "text": "בתוספת תשלום, כמובן.",
      "shown": true
    },
    {
      "start": 26.18,
      "end": 27.23,
      "text": "או נקודת איסוף!",
      "shown": true
    },
    {
      "start": 27.58,
      "end": 29.94,
      "text": "כי למה שאנחנו ניסע,\\Nאם אתם יכולים?",
      "shown": true
    },
    {
      "start": 31.18,
      "end": 32.49,
      "text": "ויש גם מסלול מיוחד!",
      "shown": true
    },
    {
      "start": 33.23,
      "end": 34.61,
      "text": "אנחנו לא מגיעים לשם.",
      "shown": true
    },
    {
      "start": 35.78,
      "end": 37.78,
      "text": "אבל רגע...\\Nאנחנו לא בישראל?!",
      "shown": true
    },
    {
      "start": 38.73,
      "end": 39.85,
      "text": "בטח שאתם בישראל!",
      "shown": true
    },
    {
      "start": 39.98,
      "end": 41.43,
      "text": "פשוט לא\\Nבאזור החלוקה.",
      "shown": true
    },
    {
      "start": 42.08,
      "end": 44.93,
      "text": "החבילה שלכם חצתה\\Nיבשות, ימים ואוקיינוסים.",
      "shown": true
    },
    {
      "start": 44.88,
      "end": 46.66,
      "text": "הגיעה כל הדרך\\Nמסין לישראל!",
      "shown": true
    },
    {
      "start": 47.38,
      "end": 48.57,
      "text": "אבל להגיע לאשכול?",
      "shown": true
    },
    {
      "start": 48.73,
      "end": 49.71,
      "text": "בואו לא נגזים.",
      "shown": true
    },
    {
      "start": 50.93,
      "end": 52.45,
      "text": "משלוחים לכל חלקי הארץ!",
      "shown": true
    },
    {
      "start": 52.73,
      "end": 53.78,
      "text": "חוץ מהחלק שלכם.",
      "shown": true
    },
    {
      "start": 54.03,
      "end": 54.55,
      "text": "בהצלחה!",
      "shown": true
    }
  ]
}