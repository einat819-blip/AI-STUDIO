  "captions": [
    {
      "start": 0.15,
      "end": 1.66,
      "text": "משלוחים לכל חלקי הארץ!",
      "shown": false
    },
    {
      "start": 2.0,
      "end": 3.9,
      "text": "מהירים, נוחים\\Nועד פתח הבית!",
      "shown": true
    },
    {
      "start": 7.87,
      "end": 8.48,
      "text": "רגע...",
      "shown": true
    },
    {
      "start": 8.62,
      "end": 9.59,
      "text": "איפה אתם גרים?",
      "shown": true
    },
    {
      "start": 10.12,
      "end": 10.57,
      "text": "אשכול?!",
      "shown": true
    },
    {
      "start": 11.72,
      "end": 12.26,
      "text": "אה...",
      "shown": true
    },
    {
      "start": 12.87,
      "end": 14.44,
      "text": "אז יש לנו כמה אפשרויות!",
      "shown": true
    },
    {
      "start": 14.57,
      "end": 15.68,
      "text": "משלוח פעם בשבוע!",
      "shown": true
    },
    {
      "start": 16.02,
      "end": 16.73,
      "text": "באיזה יום?",
      "shown": true
    },
    {
      "start": 17.22,
      "end": 18.0,
      "text": "כשיהיה נהג.",
      "shown": true
    },
    {
      "start": 21.8,
      "end": 22.78,
      "text": "משלוח עד הבית!",
      "shown": true
    },
    {
      "start": 23.1,
      "end": 24.54,
      "text": "בתוספת תשלום, כמובן.",
      "shown": true
    },
    {
      "start": 26.18,
      "end": 27.23,
      "text": "או נקודת איסוף!",
      "shown": false
    },
    {
      "start": 27.48,
      "end": 29.84,
      "text": "כי למה שאנחנו ניסע,\\Nאם אתם יכולים?",
      "shown": true
    },
    {
      "start": 31.73,
      "end": 33.04,
      "text": "ויש גם מסלול מיוחד!",
      "shown": true
    },
    {
      "start": 34.38,
      "end": 35.76,
      "text": "אנחנו לא מגיעים לשם.",
      "shown": true
    },
    {
      "start": 37.4,
      "end": 39.39,
      "text": "אבל רגע...\\Nאנחנו לא בישראל?!",
      "shown": true
    },
    {
      "start": 40.55,
      "end": 41.66,
      "text": "בטח שאתם בישראל!",
      "shown": true
    },
    {
      "start": 41.6,
      "end": 43.05,
      "text": "פשוט לא\\Nבאזור החלוקה.",
      "shown": true
    },
    {
      "start": 43.93,
      "end": 46.78,
      "text": "החבילה שלכם חצתה\\Nיבשות, ימים ואוקיינוסים.",
      "shown": true
    },
    {
      "start": 46.73,
      "end": 48.51,
      "text": "הגיעה כל הדרך\\Nמסין לישראל!",
      "shown": true
    },
    {
      "start": 48.73,
      "end": 49.92,
      "text": "אבל להגיע לאשכול?",
      "shown": true
    },
    {
      "start": 52.38,
      "end": 53.36,
      "text": "בואו לא נגזים.",
      "shown": true
    },
    {
      "start": 54.47,
      "end": 55.98,
      "text": "משלוחים לכל חלקי הארץ!",
      "shown": false
    },
    {
      "start": 56.02,
      "end": 57.06,
      "text": "חוץ מהחלק שלכם.",
      "shown": false
    },
    {
      "start": 58.27,
      "end": 58.78,
      "text": "בהצלחה!",
      "shown": false
    }
  ]
