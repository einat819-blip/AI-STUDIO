  "captions": [
    {
      "start": 0.15,
      "end": 1.93,
      "text": "משלוחים לכל חלקי הארץ!",
      "shown": false
    },
    {
      "start": 2.09,
      "end": 4.3,
      "text": "מהירים, נוחים\\Nועד פתח הבית!",
      "shown": true
    },
    {
      "start": 7.27,
      "end": 7.68,
      "text": "רגע...",
      "shown": true
    },
    {
      "start": 8.04,
      "end": 8.72,
      "text": "איפה אתם גרים?",
      "shown": true
    },
    {
      "start": 9.08,
      "end": 9.68,
      "text": "אשכול?!",
      "shown": true
    },
    {
      "start": 10.58,
      "end": 11.19,
      "text": "אה...",
      "shown": true
    },
    {
      "start": 11.73,
      "end": 13.3,
      "text": "אז יש לנו כמה אפשרויות!",
      "shown": true
    },
    {
      "start": 13.58,
      "end": 14.83,
      "text": "משלוח פעם בשבוע!",
      "shown": true
    },
    {
      "start": 15.08,
      "end": 15.67,
      "text": "באיזה יום?",
      "shown": true
    },
    {
      "start": 16.03,
      "end": 16.68,
      "text": "כשיהיה נהג.",
      "shown": true
    },
    {
      "start": 17.67,
      "end": 19.04,
      "text": "משלוח עד הבית!",
      "shown": true
    },
    {
      "start": 19.38,
      "end": 20.24,
      "text": "בתוספת תשלום,",
      "shown": true
    },
    {
      "start": 21.02,
      "end": 21.33,
      "text": "כמובן.",
      "shown": true
    },
    {
      "start": 22.08,
      "end": 23.2,
      "text": "או נקודת איסוף!",
      "shown": false
    },
    {
      "start": 23.49,
      "end": 25.5,
      "text": "כי למה שאנחנו ניסע,\\Nאם אתם יכולים?",
      "shown": true
    },
    {
      "start": 27.63,
      "end": 29.1,
      "text": "ויש גם מסלול מיוחד!",
      "shown": true
    },
    {
      "start": 30.28,
      "end": 31.45,
      "text": "אנחנו לא מגיעים לשם.",
      "shown": true
    },
    {
      "start": 32.83,
      "end": 34.73,
      "text": "אבל רגע...\\Nאנחנו לא בישראל?!",
      "shown": true
    },
    {
      "start": 35.65,
      "end": 36.95,
      "text": "בטח שאתם בישראל!",
      "shown": true
    },
    {
      "start": 37.25,
      "end": 38.5,
      "text": "פשוט לא\\Nבאזור החלוקה.",
      "shown": true
    },
    {
      "start": 39.43,
      "end": 42.82,
      "text": "החבילה שלכם חצתה\\Nיבשות, ימים ואוקיינוסים.",
      "shown": true
    },
    {
      "start": 43.18,
      "end": 45.38,
      "text": "הגיעה כל הדרך\\Nמסין לישראל!",
      "shown": true
    },
    {
      "start": 45.82,
      "end": 47.14,
      "text": "אבל להגיע לאשכול?",
      "shown": true
    },
    {
      "start": 49.09,
      "end": 49.85,
      "text": "בואו לא נגזים.",
      "shown": true
    },
    {
      "start": 50.97,
      "end": 52.78,
      "text": "משלוחים לכל חלקי הארץ!",
      "shown": false
    },
    {
      "start": 53.15,
      "end": 54.06,
      "text": "חוץ מהחלק שלכם.",
      "shown": false
    },
    {
      "start": 55.1,
      "end": 55.71,
      "text": "בהצלחה!",
      "shown": false
    }
  ]
